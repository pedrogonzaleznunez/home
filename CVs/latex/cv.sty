% =========================================================
%  Estilo del CV — compartido por cv_es.tex y cv_en.tex
%  El contenido se edita en los .tex de cada idioma; acá solo va el diseño.
% =========================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cv}

\RequirePackage[a4paper, margin=0.9cm, top=0.7cm, bottom=0.5cm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[default, lining]{raleway}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{fontawesome5}
\RequirePackage{enumitem}
\RequirePackage{array}
\RequirePackage[hidelinks, pdfusetitle]{hyperref}

\definecolor{ink}{HTML}{1E1E1E}
\definecolor{soft}{HTML}{4A4A4A}
\color{ink}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.0}
\hyphenpenalty=10000 \exhyphenpenalty=10000 % sin cortes de palabras
\newcommand{\bulletsym}{\textbullet}

% ---------- Medidas ----------
\newlength{\labelw}  \setlength{\labelw}{3.6cm}  % columna de títulos de sección
\newlength{\gutter}  \setlength{\gutter}{0.5cm}
\newlength{\bodyw}   \setlength{\bodyw}{\dimexpr\textwidth-\labelw-\gutter\relax}

% ---------- Encabezado con foto (dos columnas) ----------
% Ya no se usa: el CV es de una columna y sin foto (ver \cvheadersimple). Se deja por si se vuelve.
% \cvheader{foto}{nombre}{fecha nac.}{email}{teléfono}{ubicación}{linkedin}{github}
\newcommand{\cvheader}[8]{%
  \begin{minipage}[t]{\labelw}
    \vspace{0pt}\centering
    \begin{tikzpicture}
      \clip (0,0) circle (1.45cm);
      \node at (0,-0.3) {\includegraphics[width=3.2cm]{#1}};
    \end{tikzpicture}
  \end{minipage}%
  \hspace{\gutter}%
  \begin{minipage}[t]{\bodyw}
    \vspace{0pt}
    {\fontsize{22}{26}\selectfont\bfseries\MakeUppercase{#2}}\par
    \vspace{3pt}{\color{ink}\rule{\linewidth}{0.8pt}}\par\vspace{6pt}
    \small
    \begin{tabular}{@{}p{0.45cm}p{4.6cm}p{0.45cm}l@{}}
      \faUser & #3 & \faEnvelope & \href{mailto:#4}{#4} \\[2pt]
      \faPhone* & #5 & \faMapMarker* & #6 \\[2pt]
      \faLink & \multicolumn{3}{l}{\href{https://#7}{#7}} \\[2pt]
      \faGithub & \multicolumn{3}{l}{\href{https://#8}{#8}} \\
    \end{tabular}
  \end{minipage}\par
}

% ---------- Encabezado simple (una columna, sin foto ni fecha de nacimiento) ----------
% Solo texto (sin íconos) para que los ATS lo lean bien.
% \cvheadersimple{nombre}{titular}{email}{teléfono}{ubicación}{web}{linkedin}{github}
\newcommand{\hsep}{{\color{soft}\enspace|\enspace}}
\newcommand{\cvheadersimple}[8]{%
  {\centering
    {\fontsize{22}{26}\selectfont\bfseries\MakeUppercase{#1}}\par\vspace{3pt}
    {\fontsize{11.5}{14}\selectfont #2}\par\vspace{4pt}
    {\small #5\hsep\href{mailto:#3}{#3}\hsep #4\par\vspace{2pt}
     \href{https://#6}{#6}\hsep\href{https://#7}{#7}\hsep\href{https://#8}{#8}\par}%
  }%
}

% ---------- Secciones (una columna) ----------
\newcommand{\sectionrule}{\par\vspace{3pt}{\color{ink}\rule{\linewidth}{0.6pt}}\par\vspace{3pt}}

% \cvheading{TÍTULO}: título de sección a ancho completo con una línea debajo
\newcommand{\cvheading}[1]{%
  \par\vspace{6pt}{\bfseries\MakeUppercase{#1}}\par\vspace{-5pt}%
  {\color{ink}\rule{\linewidth}{0.6pt}}\par\vspace{-1pt}%
}

% \cvsection{TÍTULO}{contenido}
\newcommand{\cvsection}[2]{\cvheading{#1}{\small\raggedright #2\par}}

% ---------- Experiencia (un trabajo debajo del otro) ----------
% \explabel{TÍTULO} y luego un \job por trabajo
\newcommand{\explabel}[1]{\cvheading{#1}}

% \job{Puesto}{Empresa | Tipo | fechas}{Tecnologías}{\item ... \item ...}
\newcommand{\techlabel}{Technologies}
\newcommand{\job}[4]{%
  {\fontsize{11.5}{14}\selectfont\bfseries #1}{\small\color{soft}\enspace---\enspace #2}\par
  \begin{itemize}[leftmargin=1.1em, itemsep=0.5pt, parsep=0pt, topsep=1pt, label=\bulletsym]
    \small\linespread{0.95}\selectfont\raggedright #4
    \item \textbf{\techlabel:} #3
  \end{itemize}
  \vspace{4pt}
}

% ---------- Formación ----------
% \edu{Institución}{Detalle | fechas}
\newcommand{\edu}[2]{{\bfseries #1} {\color{soft}\textendash\ #2}\par\vspace{2pt}}

% ---------- Lista en línea ----------
% \inlinelist{a}{b}{c}
\newcommand{\inlinelist}[3]{#1\quad\textbullet\quad #2\quad\textbullet\quad #3}

% ---------- Lista simple ----------
\newenvironment{simplelist}{%
  \begin{itemize}[leftmargin=1em, itemsep=0pt, parsep=0pt, topsep=0pt, label=\bulletsym]
}{\end{itemize}}

% ---------- Idiomas ----------
% \lang{Idioma}{Nivel}: van en una sola línea, separados por \quad
\newcommand{\lang}[2]{\textbf{#1:} #2\qquad}
